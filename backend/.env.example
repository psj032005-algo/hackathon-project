# Required for owner authentication and order lookup-code hashing.
# Generate a private value locally; do not use a shared or committed value.
JWT_SECRET=
JWT_ISSUER=launch-store-backend
JWT_ACCESS_TOKEN_MINUTES=30

# Optional. Empty uses backend/storefront.db.
STOREFRONT_DATABASE_PATH=

# Optional AI providers. Without a key, deterministic FAQ fallback remains available.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
AI_API_KEY=
AI_MODEL=
AI_BASE_URL=https://api.openai.com/v1/responses

# Optional order status email delivery. SMTP uses STARTTLS.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
